DATABASE_URL=postgres://office:office@localhost:5432/office
JWT_SECRET=change-me-to-a-random-string-of-32+bytes
API_ADDR=127.0.0.1:8080
# Compile query macros from `.sqlx`. `just db-prepare` turns this off.
SQLX_OFFLINE=true
REDIS_URL=redis://127.0.0.1:6379
# Set to true when the API is served over HTTPS (adds Secure to the refresh cookie).
COOKIE_SECURE=false
