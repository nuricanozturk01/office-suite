{
  "name": "office-suite",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "gen:api": "pnpm --filter @office/api-client gen",
    "dev:web": "pnpm --filter @office/web dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write apps/web packages",
    "format:check": "prettier --check apps/web packages"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1"
  }
}
