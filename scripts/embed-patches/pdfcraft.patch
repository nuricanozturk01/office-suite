+/// Commands that open or create other documents. The page that hosts the editor keeps one file per
+/// editor, so there they are left out of menus and tool lists and do nothing.
+pub(crate) fn hosted_hidden(id: &str) -> bool {
+    id.starts_with("create.") || matches!(id, "page.combine" | "file.open_recent" | "file.pin_folder" | "file.close_all")
+}
+
+/// Tool groups (by catalogue id) made of such commands.
+pub(crate) fn hosted_hidden_group(id: &str) -> bool {
+    matches!(id, "create" | "combine")
+}
