diff --git a/apps/deckcraft-web/src/host.rs b/apps/deckcraft-web/src/host.rs
new file mode 100644
index 00000000..b66057ec
--- /dev/null
+++ b/apps/deckcraft-web/src/host.rs
@@ -0,0 +1,131 @@
+//! The `postMessage` bridge to a same-origin parent page (`?host=parent`), for pages that embed
+//! DeckCraft in an `<iframe>` and keep its files. Same messages as WordCraft's bridge:
+//!
+//! - `deckcraft:ready` (to the parent): `{ version }`, the app is listening; send a file now.
+//! - `deckcraft:open` (from the parent): `{ name, bytes }`; it opens like a dropped file.
+//! - `deckcraft:save` (to the parent): `{ name, saveAs, bytes }` for every file DeckCraft would
+//!   otherwise download (Save, Save As, exports).
+//! - `deckcraft:dirty` (to the parent): `{ dirty }` whenever "has unsaved changes" flips.
+//! - `deckcraft:failed` (to the parent): `{ error }` when the app couldn't start.
+//!
+//! Only the parent window on the page's own origin is heard or answered.
+
+use std::cell::RefCell;
+use std::rc::Rc;
+
+use wasm_bindgen::JsCast as _;
+use wasm_bindgen::JsValue;
+use wasm_bindgen::closure::Closure;
+
+/// Files the parent sent, waiting for the app to open them.
+pub type Opens = Rc<RefCell<Vec<(String, Vec<u8>)>>>;
+
+#[derive(Clone)]
+pub struct Bridge {
+    window: web_sys::Window,
+    parent: web_sys::Window,
+    origin: String,
+}
+
+impl Bridge {
+    /// `None` when the page isn't framed by a page on its own origin.
+    pub fn new() -> Option<Self> {
+        let window = web_sys::window()?;
+        let parent = window.parent().ok().flatten()?;
+        if js_sys::Object::is(&parent, &window) {
+            return None;
+        }
+        let origin = window.location().origin().ok()?;
+        if origin == "null" || parent.location().origin().ok()? != origin {
+            return None;
+        }
+        Some(Self { window, parent, origin })
+    }
+
+    pub fn post_ready(&self) {
+        self.send(&[("type", "deckcraft:ready".into()), ("version", env!("CARGO_PKG_VERSION").into())]);
+    }
+
+    /// Hands a file-level command to the page; true when it was sent.
+    pub fn post_command(&self, command: &str) -> bool {
+        self.send(&[("type", "deckcraft:command".into()), ("command", command.into())])
+    }
+
+    /// Tells the page whether any open deck has unsaved changes; true when it was sent.
+    pub fn post_dirty(&self, dirty: bool) -> bool {
+        self.send(&[("type", "deckcraft:dirty".into()), ("dirty", dirty.into())])
+    }
+
+    /// Tells the page the user renamed the deck (set its title).
+    pub fn post_renamed(&self, name: &str) {
+        self.send(&[("type", "deckcraft:renamed".into()), ("name", name.into())]);
+    }
+
+    pub fn post_failed(&self, error: &str) {
+        self.send(&[("type", "deckcraft:failed".into()), ("error", error.into())]);
+    }
+
+    pub fn post_save(&self, path: &str, bytes: &[u8]) -> Result<(), String> {
+        let name = std::path::Path::new(path).file_name().map(|n| n.to_string_lossy().to_string()).unwrap_or_else(|| path.to_string());
+        let buffer = js_sys::Uint8Array::from(bytes).buffer();
+        let message = message(&[
+            ("type", "deckcraft:save".into()),
+            ("name", name.as_str().into()),
+            ("saveAs", false.into()),
+            ("bytes", buffer.clone().into()),
+        ])
+        .ok_or_else(|| "couldn't build the message".to_string())?;
+        self.parent
+            .post_message_with_transfer(&message, &self.origin, &js_sys::Array::of1(&buffer))
+            .map_err(|e| e.as_string().unwrap_or_else(|| format!("{e:?}")))
+    }
+
+    /// Hear `deckcraft:open` from the parent and queue the file.
+    pub fn listen(&self, opens: Opens, ctx: egui::Context) {
+        let parent = self.parent.clone();
+        let origin = self.origin.clone();
+        let on_message = Closure::<dyn FnMut(web_sys::MessageEvent)>::new(move |event: web_sys::MessageEvent| {
+            if event.origin() != origin || !event.source().is_some_and(|s| js_sys::Object::is(&s, &parent)) {
+                return;
+            }
+            let data = event.data();
+            if string(&data, "type").as_deref() != Some("deckcraft:open") {
+                return;
+            }
+            let name = string(&data, "name").filter(|n| !n.trim().is_empty()).unwrap_or_else(|| "Presentation.pptx".to_string());
+            let Some(bytes) = bytes(&data) else { return };
+            opens.borrow_mut().push((name, bytes));
+            ctx.request_repaint();
+        });
+        if self.window.add_event_listener_with_callback("message", on_message.as_ref().unchecked_ref()).is_ok() {
+            on_message.forget();
+        }
+    }
+
+    fn send(&self, fields: &[(&str, JsValue)]) -> bool {
+        message(fields).is_some_and(|m| self.parent.post_message(&m, &self.origin).is_ok())
+    }
+}
+
+fn message(fields: &[(&str, JsValue)]) -> Option<js_sys::Object> {
+    let m = js_sys::Object::new();
+    for (key, value) in fields {
+        js_sys::Reflect::set(&m, &JsValue::from_str(key), value).ok()?;
+    }
+    Some(m)
+}
+
+fn string(data: &JsValue, key: &str) -> Option<String> {
+    js_sys::Reflect::get(data, &JsValue::from_str(key)).ok()?.as_string()
+}
+
+fn bytes(data: &JsValue) -> Option<Vec<u8>> {
+    let bytes = js_sys::Reflect::get(data, &JsValue::from_str("bytes")).ok()?;
+    if let Some(array) = bytes.dyn_ref::<js_sys::Uint8Array>() {
+        Some(array.to_vec())
+    } else if bytes.is_instance_of::<js_sys::ArrayBuffer>() {
+        Some(js_sys::Uint8Array::new(&bytes).to_vec())
+    } else {
+        None
+    }
+}
